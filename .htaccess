RewriteEngine On

# StackCP panel path in browser is NOT the public site URL — redirect to domain root
RewriteCond %{REQUEST_URI} ^/home/sites/ [NC]
RewriteRule ^home/sites/.*/public_html/(.*)$ /$1 [R=302,L,QSD]

RewriteRule ^assets/ - [L]
RewriteRule ^client-apps/ - [L]
# Do not force RewriteBase; let Apache resolve relative to this directory

# Hosting panel paths: never apply tenant slug rules
RewriteRule ^home/ - [L]

# Diagnostic scripts: never rewrite as /{company_slug}/...
RewriteRule ^(debug_[a-zA-Z0-9_.-]+\.php|reset_company_admin\.php|health-check\.php|hc\.php|ping\.php)$ - [L,NC]
RewriteCond %{REQUEST_URI} /(debug_[a-zA-Z0-9_.-]+\.php|hc\.php|ping\.php)$ [NC]
RewriteRule ^ - [L]

# /{company_slug}/debug_*.php -> root debug script (ultimate/ folder exists on disk)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/(debug_[a-zA-Z0-9_.-]+\.php)$ $2?company_slug=$1 [QSA,L,NC]

# Company slug routing (single codebase, no subdomains)
# General Tenant Proxy: /{company_slug}/{file}.php -> {file}.php?company_slug={company_slug}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/([^/]+\.php)$ $2?company_slug=$1 [QSA,L,NC]

# General Tenant Proxy for subdirectories (e.g., /roadmaster/employee/dashboard.php -> employee/dashboard.php?company_slug=roadmaster)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/(.+\.php)$ $2?company_slug=$1 [QSA,L,NC]


# /{company_slug}/login
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/login/?$ login.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/owner/sites/dashboard
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/owner/sites/dashboard/?$ select-module.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/select-module
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/select-module/?$ select-module.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/attendance
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/attendance/?$ attendance/index.php?module=attendance&company_slug=$1 [QSA,L,NC]
# /{company_slug}/register
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/register/?$ register.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/sales
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/sales/?$ modules/sales/dashboard/index.php?module=sales&company_slug=$1 [QSA,L,NC]
# /{company_slug}/stock
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/?$ stock/dashboard.php?module=stocks&company_slug=$1 [QSA,L,NC]
# /{company_slug}/accounting
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/accounting/?$ modules/accounting/index.php?module=accounting&company_slug=$1 [QSA,L,NC]
# /{company_slug}/todo
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/todo/?$ todo/index.php?module=todo&company_slug=$1 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/todo/index/?$ todo/index.php?module=todo&company_slug=$1 [QSA,L,NC]
# /{company_slug}/deliveries
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/deliveries/?$ deliveries/index.php?module=deliveries&company_slug=$1 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/deliveries/index/?$ deliveries/index.php?module=deliveries&company_slug=$1 [QSA,L,NC]
# /{company_slug}/payment-vouchers (React All Vouchers desk)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/payment-vouchers/?$ admin/all-vouchers.php?module=voucher&company_slug=$1 [QSA,L,NC]
# /{company_slug}/revenue
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/revenue/?$ revenue_entries.php?module=revenue&company_slug=$1 [QSA,L,NC]
# /{company_slug} -> dashboard
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/?$ select-module.php?company_slug=$1 [QSA,L,NC]

# General Tenant Proxy for extensionless paths (e.g., /roadmaster/employee/dashboard -> employee/dashboard.php?company_slug=roadmaster)
# Moved to end of tenant rules to allow specific aliases to match first.
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/([^.]+)$ $2.php?company_slug=$1 [QSA,L,NC]

# If the request points to a file or directory that exists, allow it through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Add .php extension if file exists (for extensionless URLs)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ $1 [R=301,L]
# Handle 404 Errors properly
# Without a leading "/", Apache treats the value as a literal response body (shows "404.php" text).
# Local XAMPP uses /public_html/... ; production DocumentRoot is usually this folder.
<If "%{REQUEST_URI} =~ m#^/public_html/#">
ErrorDocument 404 /public_html/404.php
</If>
<Else>
ErrorDocument 404 /404.php
</Else>
