# StackCP / 20i: run site on PHP 8.2+ (erp-laravel / Laravel 12 requires >= 8.2)
#+PHPVersion
#="php82"
AddHandler x-httpd-php82 .php
#-PHPVersion

RewriteEngine On

# StackCP panel path in browser is NOT the public site URL — redirect to domain root
RewriteCond %{REQUEST_URI} ^/home/sites/ [NC]
RewriteRule ^home/sites/.*/public_html/(.*)$ /$1 [R=302,L,QSD]

RewriteRule ^assets/ - [L]
RewriteRule ^client-apps/ - [L]
# Do not force RewriteBase; let Apache resolve relative to this directory

# Hosting panel paths: never apply tenant slug rules
RewriteRule ^home/ - [L]

# Diagnostic scripts: never rewrite as /{company_slug}/...
RewriteRule ^(debug_[a-zA-Z0-9_.-]+\.php|reset_company_admin\.php|health-check\.php|hc\.php|ping\.php|capture-bootstrap\.php)$ - [L,NC]
RewriteCond %{REQUEST_URI} /(debug_[a-zA-Z0-9_.-]+\.php|hc\.php|ping\.php)$ [NC]
RewriteRule ^ - [L]

# /{company_slug}/debug_*.php -> root debug script (ultimate/ folder exists on disk)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/(debug_[a-zA-Z0-9_.-]+\.php)$ $2?company_slug=$1 [QSA,L,NC]

# Company slug routing (single codebase, no subdomains)
# General Tenant Proxy: /{company_slug}/{file}.php -> {file}.php?company_slug={company_slug}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/([^/]+\.php)$ $2?company_slug=$1 [QSA,L,NC]

# General Tenant Proxy for subdirectories (e.g., /roadmaster/employee/dashboard.php -> employee/dashboard.php?company_slug=roadmaster)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/(.+\.php)$ $2?company_slug=$1 [QSA,L,NC]


# /{company_slug}/login
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/login/?$ login.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/owner/sites/dashboard
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/owner/sites/dashboard/?$ select-module.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/select-module
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/select-module/?$ select-module.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/suggest (must be explicit: physical /ultimate/ dir breaks the generic !-d proxy)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/suggest/?$ suggest.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/payroll → Laravel+React payroll desk
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/payroll/?$ payroll.php?company_slug=$1&module=payroll [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/payroll/(run-payroll)/?$ payroll.php?company_slug=$1&module=payroll&desk=$2 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/modules/payroll/index(\.php)?$ payroll.php?company_slug=$1&module=payroll [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/modules/payroll/run_payroll\.php$ payroll.php?company_slug=$1&module=payroll&desk=run-payroll [QSA,L,NC]
# /{company_slug}/attendance
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/attendance/?$ attendance/index.php?module=attendance&company_slug=$1 [QSA,L,NC]
# /{company_slug}/register
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/register/?$ register.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/sales → Laravel+React sales desk
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/sales/?$ sales.php?company_slug=$1 [QSA,L,NC]
# /{company_slug}/sales/{desk}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/sales/(invoices|orders|customers|my-sales|catalogue|customer-catalogue|pricelist|settings|quotations|quote-create|invoice-create|payment-create|admin-targets|admin-reassign|products-view|send-doc|order-view|invoice-view|quote-edit|delivery-note)/?$ sales.php?company_slug=$1&desk=$2 [QSA,L,NC]
# /{company_slug}/sales/order/{id} and invoice/{id}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/sales/order/([0-9]+)/?$ sales.php?company_slug=$1&desk=order-view&id=$2 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/sales/invoice/([0-9]+)/?$ sales.php?company_slug=$1&desk=invoice-view&id=$2 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/sales/quote/([0-9]+)/edit/?$ sales.php?company_slug=$1&desk=quote-edit&id=$2 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/sales/print/(order|invoice)/([0-9]+)/?$ sales.php?company_slug=$1&desk=print-$2&id=$3 [QSA,L,NC]
# /{company_slug}/stock → erp-laravel Domains/Stock (stock.php)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/?$ stock.php?module=stocks&company_slug=$1 [QSA,L,NC]
# /{company_slug}/stock/{desk}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/(dashboard|catalogue|settings|product-detail|products|product-view|product-create|product-edit|products-import|categories|category-add|category-edit|brands|brand-edit|uploads|uploads-upload|uploads-recycle|suppliers|supplier-add|supplier-edit|supplier-view|statements|shipments|shipment-create|shipment-edit|shipment-view|shipment-receive|shipment-import|shippers|shipper-add|shipper-edit|purchases|purchase-create|purchase-edit|purchase-view|purchase-receive|purchase-classification|purchase-payments|purchase-receipt-audit|replenishment|reports|reports-purchases|movements|stock-adjust|stock-batches|transfers|fleet-parts|analytics)/?$ stock.php?module=stocks&company_slug=$1&desk=$2 [QSA,L,NC]
# /{company_slug}/stock/product/{id}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/product/([0-9]+)/?$ stock.php?module=stocks&company_slug=$1&desk=product-view&id=$2 [QSA,L,NC]
# /{company_slug}/stock/purchase/{id}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/purchase/([0-9]+)/?$ stock.php?module=stocks&company_slug=$1&desk=purchase-view&id=$2 [QSA,L,NC]
# /{company_slug}/stock/shipment/{id}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/shipment/([0-9]+)/?$ stock.php?module=stocks&company_slug=$1&desk=shipment-view&id=$2 [QSA,L,NC]
# /{company_slug}/stock/supplier/{id}
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/supplier/([0-9]+)/?$ stock.php?module=stocks&company_slug=$1&desk=supplier-view&id=$2 [QSA,L,NC]
# Legacy /{slug}/stock/modules/... → desks
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/modules/products/add\.php$ stock.php?module=stocks&company_slug=$1&desk=product-create [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/modules/products/index\.php$ stock.php?module=stocks&company_slug=$1&desk=products [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/modules/products/edit\.php$ stock.php?module=stocks&company_slug=$1&desk=product-edit [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/edit\.php$ stock.php?module=stocks&company_slug=$1&desk=product-edit [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/modules/products/view\.php$ stock.php?module=stocks&company_slug=$1&desk=product-view [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/modules/products/categories\.php$ stock.php?module=stocks&company_slug=$1&desk=categories [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/catalogue\.php$ stock.php?module=stocks&company_slug=$1&desk=catalogue [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/stock/settings\.php$ stock.php?module=stocks&company_slug=$1&desk=settings [QSA,L,NC]
# /{company_slug}/accounting
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/accounting/?$ modules/accounting/index.php?module=accounting&company_slug=$1 [QSA,L,NC]
# /{company_slug}/todo
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/todo/?$ todo/index.php?module=todo&company_slug=$1 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/todo/index/?$ todo/index.php?module=todo&company_slug=$1 [QSA,L,NC]
# /{company_slug}/deliveries
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/deliveries/?$ deliveries/index.php?module=deliveries&company_slug=$1 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/deliveries/index/?$ deliveries/index.php?module=deliveries&company_slug=$1 [QSA,L,NC]
# /{company_slug}/payment-vouchers (React All Vouchers desk)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/payment-vouchers/?$ admin/all-vouchers.php?module=voucher&company_slug=$1 [QSA,L,NC]
# /{company_slug}/revenue
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/revenue/?$ revenue_entries.php?module=revenue&company_slug=$1 [QSA,L,NC]
# /{company_slug}/customer_statement (explicit: physical /ultimate/ breaks generic !-d proxy)
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/customer_statement/?$ customer_statement/index.php?company_slug=$1 [QSA,L,NC]
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/customer_statement/(.+)$ customer_statement/$2?company_slug=$1 [QSA,L,NC]
# /{company_slug} -> dashboard
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteRule ^([A-Za-z0-9-]+)/?$ select-module.php?company_slug=$1 [QSA,L,NC]

# General Tenant Proxy for extensionless paths (e.g., /roadmaster/employee/dashboard -> employee/dashboard.php?company_slug=roadmaster)
# Moved to end of tenant rules to allow specific aliases to match first.
RewriteCond %{REQUEST_URI} !^/home/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/([^.]+)$ $2.php?company_slug=$1 [QSA,L,NC]

# If the request points to a file or directory that exists, allow it through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Add .php extension if file exists (for extensionless URLs)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ $1 [R=301,L]
# Handle 404 Errors properly
# Without a leading "/", Apache treats the value as a literal response body (shows "404.php" text).
# Local XAMPP uses /public_html/... ; production DocumentRoot is usually this folder.
<If "%{REQUEST_URI} =~ m#^/public_html/#">
ErrorDocument 404 /public_html/404.php
</If>
<Else>
ErrorDocument 404 /404.php
</Else>
