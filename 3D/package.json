{
  "name": "bcut",
  "private": true,
  "version": "1.0.0",
  "description": "BCUT — AI background remover and image editor",
  "author": "BCUT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5180 && electron .\"",
    "desktop:build": "node electron/run-desktop-build.cjs",
    "desktop:build:win": "node electron/run-desktop-build.cjs",
    "android:add": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "node scripts/run-android-build.cjs",
    "android:build:debug": "node scripts/run-android-build.cjs --debug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@imgly/background-removal": "^1.7.0",
    "canvas-confetti": "^1.9.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.bcut.desktop",
    "productName": "BCUT",
    "copyright": "Copyright © BCUT",
    "directories": {
      "output": "release",
      "buildResources": "electron/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName} Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BCUT",
      "differentialPackage": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://YOUR-DOMAIN.com/bcut/updates/"
    }
  }
}
